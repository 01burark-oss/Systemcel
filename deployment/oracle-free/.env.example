# İlk hazırlık testinde: http://SUNUCU_PUBLIC_IP
# DNS taşınırken: systemcel.app
CADDY_SITE_ADDRESS=http://89.168.102.124

ASPNETCORE_ENVIRONMENT=Production
SYSTEMCEL_ENVIRONMENT_NAME=oracle-production-candidate
SYSTEMCEL_ALLOWED_ORIGINS=https://systemcel.app
SYSTEMCEL_PUBLIC_BASE_URL=https://systemcel.app

POSTGRES_DB=systemcel
POSTGRES_USER=systemcel_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Bir kez üretin: openssl rand -base64 32
SYSTEMCEL_SECRET_ENCRYPTION_KEY=

SYSTEMCEL_CLERK_ENABLED=true
SYSTEMCEL_CLERK_AUTHORITY=
SYSTEMCEL_CLERK_PUBLISHABLE_KEY=
SYSTEMCEL_CLERK_AUTHORIZED_PARTIES=https://systemcel.app
SYSTEMCEL_CLERK_LEGACY_USER_IDS=
SYSTEMCEL_ADMIN_CLERK_USER_IDS=
SYSTEMCEL_ADMIN_EMAILS=
Systemcel__Features__AccountantMarketplaceEnabled=false
VITE_ACCOUNTANT_MARKETPLACE_ENABLED=false

# Şirket ve gerçek sağlayıcı kapısı açılana kadar yalnız deterministik Fake sağlayıcıyı kullanın.
SYSTEMCEL_PAYMENT_PROVIDER=Fake

SYSTEMCEL_SMTP_HOST=
SYSTEMCEL_SMTP_PORT=587
SYSTEMCEL_SMTP_ENABLE_SSL=true
SYSTEMCEL_SMTP_USERNAME=
SYSTEMCEL_SMTP_PASSWORD=
SYSTEMCEL_SMTP_FROM_ADDRESS=
SYSTEMCEL_SMTP_FROM_NAME=Systemcel

SYSTEMCEL_SMS_PROVIDER=Netgsm
NETGSM_BASE_URL=https://api.netgsm.com.tr
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_APPNAME=systemcel
SYSTEMCEL_CUSTOMER_APPROVAL_EXPIRY_HOURS=72
SYSTEMCEL_CUSTOMER_APPROVAL_RESEND_MINUTES=15

Telegram__BotToken=
Telegram__AllowedUserIds=
Telegram__ChatId=

ReceiptOcr__Provider=OpenAI
ReceiptOcr__ApiKey=
ReceiptOcr__BaseUrl=https://api.openai.com/v1
ReceiptOcr__Model=gpt-5-mini
DeepSeek__ApiKey=
DeepSeek__ProModel=deepseek-flash
DeepSeek__FlashModel=deepseek-flash
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
