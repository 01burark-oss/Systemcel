ASPNETCORE_ENVIRONMENT=Development
SYSTEMCEL_ENVIRONMENT_NAME=local
SYSTEMCEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SYSTEMCEL_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=systemcel_dev;Username=systemcel_app;Password=replace-me

# Production/staging zorunlu: `openssl rand -base64 32` ile üretip DigitalOcean encrypted secret olarak saklayın.
# Anahtarı değiştirmeden önce mevcut şifreli kayıtlar yeniden şifrelenmelidir; kayıp anahtar geri getirilemez.
SYSTEMCEL_SECRET_ENCRYPTION_KEY=

SYSTEMCEL_CLERK_AUTHORITY=https://<clerk-domain>
SYSTEMCEL_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>
SYSTEMCEL_CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
SYSTEMCEL_ADMIN_CLERK_USER_IDS=
SYSTEMCEL_ADMIN_EMAILS=

# Systemcel abonelik bildirimleri ve musterilere gonderilen odeme hatirlatmalari
# bu sirket e-posta hesabindan gonderilir.
# Bos birakilirsa e-posta gonderimi yapilmaz.
SYSTEMCEL_SMTP_HOST=
SYSTEMCEL_SMTP_PORT=587
SYSTEMCEL_SMTP_ENABLE_SSL=true
SYSTEMCEL_SMTP_USERNAME=
SYSTEMCEL_SMTP_PASSWORD=
SYSTEMCEL_SMTP_FROM_ADDRESS=
SYSTEMCEL_SMTP_FROM_NAME=Systemcel
SYSTEMCEL_PUBLIC_BASE_URL=https://systemcel.app

# Fatura taslağını müşteriye güvenli bağlantıyla teyit ettirme SMS'i.
# Netgsm API alt kullanıcısı ve onaylı gönderici başlığı gerektirir.
SYSTEMCEL_SMS_PROVIDER=Netgsm
NETGSM_BASE_URL=https://api.netgsm.com.tr
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_APPNAME=systemcel
SYSTEMCEL_CUSTOMER_APPROVAL_EXPIRY_HOURS=72
SYSTEMCEL_CUSTOMER_APPROVAL_RESEND_MINUTES=15

Telegram__BotToken=
Telegram__AllowedUserIds=
Telegram__ChatId=

ReceiptOcr__ApiKey=
DeepSeek__ApiKey=
